# Copy to .env and adjust. Never commit .env. No real secrets belong in this file.

NODE_ENV=development
PORT=3000

# SQLite database file (put this on a persistent disk/volume when deploying)
DB_PATH=./data/booking.db

# Set true when served over HTTPS (required for production). Cookies are marked Secure.
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy / PaaS router (nginx, Render, Railway, Fly...)
TRUST_PROXY=

# Session lifetime
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120

# Login/registration attempts allowed per IP per 15 minutes
LOGIN_RATE_MAX=20

# Optional email (leave blank = notifications are in-app only; the app will NOT pretend otherwise)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mentor Sessions <no-reply@example.com>"

# Used only by `npm run init-admin` (optional; it prompts / generates a password if omitted)
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
