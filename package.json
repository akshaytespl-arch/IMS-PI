{
  "name": "student-mentor-booking",
  "version": "1.0.0",
  "description": "Student-mentor appointment booking with private mentor identities",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "migrate": "node --disable-warning=ExperimentalWarning -e \"const c=require('./src/config');const d=require('./src/db');const db=d.openDb(c.dbPath);console.log('applied:',d.migrate(db))\"",
    "init-admin": "node --disable-warning=ExperimentalWarning scripts/init-admin.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "nodemailer": "^10.5.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
